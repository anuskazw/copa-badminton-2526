---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #fff;
      min-height: 100vh;
      color: #1a1a1a;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 40px 100px;
    }

    header {
      padding-bottom: 30px;
      margin-bottom: 30px;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    header h1 {
      color: #1a1a1a;
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .subtitle {
      color: #888;
      font-size: 0.95rem;
    }

    main {
      padding: 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🏸 Copa de Bádminton FMDS</h1>
      <p class="subtitle">Temporada 2025/2026</p>
    </header>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>
