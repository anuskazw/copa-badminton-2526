---

<Layout title="Tablón de Partidos - Copa Femenina de Clubes">
  <h2>📅 Partidos Programados</h2>
  <div class="info">
    <p><strong>Fecha:</strong> 15-23 Febrero 2025</p>
    <p><strong>Sistema:</strong> Fase de Grupos + Eliminación Directa</p>
    <p><strong>Formato:</strong> 5 partidos por encuentro (DF2, DF1, IF3, IF2, IF1)</p>
  </div>
  
  <div class="partidos-container">
    {partidos.map(partido => (
      <Partido 
        fecha={partido.fecha}
        hora={partido.hora}
        fase={partido.fase}
        equipoLocal={partido.equipoLocal}
        equipoVisitante={partido.equipoVisitante}
        pista={partido.pista}
      />
    ))}
  </div>
</Layout>

<style>
  h2 {
    color: #667eea;
    margin-bottom: 20px;
    font-size: 2rem;
  }

  .info {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 30px;
    border-left: 5px solid #667eea;
  }

  .info p {
    margin: 8px 0;
    color: #555;
  }

  .partidos-container {
    margin-top: 20px;
  }
</style>
