---
import Layout from '../layouts/Layout.astro';

// DOBLES FEMENINO
const doblesParticipantes = [
  { letra: 'A', nombre: 'Margarita Arizaga / Dora Yánez' },
  { letra: 'B', nombre: 'Paula Bak / Mónica Castrillejo' },
  { letra: 'C', nombre: 'Nadia Marcos / María Jesús Serna' },
  { letra: 'D', nombre: 'Mónica Rodríguez / Ana María Caballero' }
];

const doblesPartidos = [
  { ronda: 1, partidos: [{ local: 'A', visitante: 'B' }, { local: 'C', visitante: 'D' }] },
  { ronda: 2, partidos: [{ local: 'A', visitante: 'C' }, { local: 'B', visitante: 'D' }] },
  { ronda: 3, partidos: [{ local: 'A', visitante: 'D' }, { local: 'B', visitante: 'C' }] }
];

// INDIVIDUAL FEMENINO
const individualGrupoA = [
  { letra: 'A', nombre: 'Mónica Rodríguez' },
  { letra: 'B', nombre: 'Paula Bak' },
  { letra: 'C', nombre: 'Margarita Arizaga' }
];

const individualGrupoB = [
  { letra: 'D', nombre: 'Mónica Castrillejo' },
  { letra: 'E', nombre: 'Jamie Gissel Valencia' }
];

const individualPartidosA = [
  { local: 'A', visitante: 'B' },
  { local: 'A', visitante: 'C' },
  { local: 'B', visitante: 'C' }
];

const individualPartidosB = [
  { local: 'D', visitante: 'E' }
];
---

<Layout title="Copa de Bádminton FMDS 2025/2026">
  <div class="info">
    <p><strong>📍 Horario:</strong> 10:00 - 20:00</p>
    <p><strong>📋 Grupos:</strong> 1 set a 21 · <strong>Eliminatorias:</strong> 2 sets a 21 (3º a 15)</p>
  </div>

  <!-- DOBLES FEMENINO -->
  <section class="modalidad">
    <h2>👥 Dobles Femenino</h2>

    <h3>Participantes</h3>
    <div class="participantes-grid">
      {doblesParticipantes.map(p => (
        <div class="participante-tag">
          <span class="letra">{p.letra}</span>
          <span>{p.nombre}</span>
        </div>
      ))}
    </div>

    <h3>Fase de grupos</h3>
    <p class="formato-nota">Todas contra todas · 1 set a 21 · Clasifican 1ª y 2ª</p>

    <div class="partidos-grupos">
      {doblesPartidos.map(r => (
        <div class="ronda-partidos">
          <div class="ronda-label">Ronda {r.ronda}</div>
          {r.partidos.map(p => (
            <div class="partido-card" data-match>
              <div class="partido-equipo" data-team="1">
                <span class="equipo-letra">{p.local}</span>
                <div class="sets-ganados"><span data-sets-won>-</span></div>
                <div class="puntos-set">
                  <input type="text" maxlength="2" data-set="1" />
                  <input type="text" maxlength="2" data-set="2" />
                  <input type="text" maxlength="2" class="third" data-set="3" />
                </div>
              </div>
              <div class="partido-equipo" data-team="2">
                <span class="equipo-letra">{p.visitante}</span>
                <div class="sets-ganados"><span data-sets-won>-</span></div>
                <div class="puntos-set">
                  <input type="text" maxlength="2" data-set="1" />
                  <input type="text" maxlength="2" data-set="2" />
                  <input type="text" maxlength="2" class="third" data-set="3" />
                </div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="clasificacion-box">
      <div class="clasificacion-title">Clasificación</div>
      <table class="tabla-clasificacion">
        <thead>
          <tr>
            <th>#</th>
            <th>Pareja</th>
            <th>J</th>
            <th>G</th>
            <th>P</th>
            <th>Pts</th>
          </tr>
        </thead>
        <tbody>
          {doblesParticipantes.map((p, i) => (
            <tr>
              <td class="pos">{i + 1}</td>
              <td class="nombre"><span class="letra-mini">{p.letra}</span> {p.nombre}</td>
              <td>-</td>
              <td>-</td>
              <td>-</td>
              <td class="pts">-</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>Final</h3>
    <p class="formato-nota">2 sets a 21 · Tercer set a 15 si hay empate</p>
    <div class="bracket">
      <div class="bracket-round">
        <div class="match final-match" data-match>
          <div class="match-team" data-team="1">
            <span class="team-name">1ª Clasificada</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
          <div class="match-team" data-team="2">
            <span class="team-name">2ª Clasificada</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
        </div>
      </div>
      <div class="bracket-round trophy">
        <div class="trophy-icon">🏆</div>
      </div>
    </div>
  </section>

  <!-- INDIVIDUAL FEMENINO -->
  <section class="modalidad">
    <h2>🏃‍♀️ Individual Femenino</h2>

    <h3>Fase de grupos</h3>
    <p class="formato-nota">1 set a 21 · Clasifican 1ª y 2ª de cada grupo</p>

    <div class="grupos-grid">
      <div class="grupo-box">
        <h4>Grupo A</h4>
        <div class="participantes-mini">
          {individualGrupoA.map(p => (
            <div class="participante-mini">
              <span class="letra">{p.letra}</span>
              <span>{p.nombre}</span>
            </div>
          ))}
        </div>
        <div class="partidos-lista">
          {individualPartidosA.map(p => (
            <div class="partido-card compact" data-match>
              <div class="partido-equipo" data-team="1">
                <span class="equipo-letra">{p.local}</span>
                <div class="sets-ganados"><span data-sets-won>-</span></div>
                <div class="puntos-set">
                  <input type="text" maxlength="2" data-set="1" />
                  <input type="text" maxlength="2" data-set="2" />
                  <input type="text" maxlength="2" class="third" data-set="3" />
                </div>
              </div>
              <div class="partido-equipo" data-team="2">
                <span class="equipo-letra">{p.visitante}</span>
                <div class="sets-ganados"><span data-sets-won>-</span></div>
                <div class="puntos-set">
                  <input type="text" maxlength="2" data-set="1" />
                  <input type="text" maxlength="2" data-set="2" />
                  <input type="text" maxlength="2" class="third" data-set="3" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="grupo-box">
        <h4>Grupo B</h4>
        <div class="participantes-mini">
          {individualGrupoB.map(p => (
            <div class="participante-mini">
              <span class="letra">{p.letra}</span>
              <span>{p.nombre}</span>
            </div>
          ))}
        </div>
        <div class="partidos-lista">
          {individualPartidosB.map(p => (
            <div class="partido-card compact" data-match>
              <div class="partido-equipo" data-team="1">
                <span class="equipo-letra">{p.local}</span>
                <div class="sets-ganados"><span data-sets-won>-</span></div>
                <div class="puntos-set">
                  <input type="text" maxlength="2" data-set="1" />
                  <input type="text" maxlength="2" data-set="2" />
                  <input type="text" maxlength="2" class="third" data-set="3" />
                </div>
              </div>
              <div class="partido-equipo" data-team="2">
                <span class="equipo-letra">{p.visitante}</span>
                <div class="sets-ganados"><span data-sets-won>-</span></div>
                <div class="puntos-set">
                  <input type="text" maxlength="2" data-set="1" />
                  <input type="text" maxlength="2" data-set="2" />
                  <input type="text" maxlength="2" class="third" data-set="3" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <h3>Eliminatorias</h3>
    <p class="formato-nota">2 sets a 21 · Tercer set a 15 si hay empate</p>
    <div class="bracket">
      <div class="bracket-round">
        <div class="round-label">Semifinales</div>
        <div class="match" data-match>
          <div class="match-team" data-team="1">
            <span class="team-name">1ª Grupo A</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
          <div class="match-team" data-team="2">
            <span class="team-name">2ª Grupo B</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
        </div>
        <div class="match" data-match>
          <div class="match-team" data-team="1">
            <span class="team-name">1ª Grupo B</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
          <div class="match-team" data-team="2">
            <span class="team-name">2ª Grupo A</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
        </div>
      </div>

      <div class="bracket-connector">
        <div class="connector-line top"></div>
        <div class="connector-line bottom"></div>
        <div class="connector-merge"></div>
      </div>

      <div class="bracket-round">
        <div class="round-label">Final</div>
        <div class="match final-match" data-match>
          <div class="match-team" data-team="1">
            <span class="team-name">Ganadora SF1</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
          <div class="match-team" data-team="2">
            <span class="team-name">Ganadora SF2</span>
            <div class="score-total"><span data-sets-won>-</span></div>
            <div class="score-boxes">
              <input type="text" class="score-input" maxlength="2" data-set="1" />
              <input type="text" class="score-input" maxlength="2" data-set="2" />
              <input type="text" class="score-input third" maxlength="2" data-set="3" />
            </div>
          </div>
        </div>
      </div>

      <div class="bracket-round trophy">
        <div class="trophy-icon">🏆</div>
      </div>
    </div>
  </section>

  <section class="sin-participacion">
    <p>Sin participación: Dobles Mixto · Dobles Masculino · Individual Masculino</p>
  </section>
</Layout>

<script>
  function calculateSetsWon() {
    document.querySelectorAll('[data-match]').forEach(match => {
      const team1 = match.querySelector('[data-team="1"]');
      const team2 = match.querySelector('[data-team="2"]');

      if (!team1 || !team2) return;

      let sets1 = 0;
      let sets2 = 0;

      for (let i = 1; i <= 3; i++) {
        const input1 = team1.querySelector(`[data-set="${i}"]`);
        const input2 = team2.querySelector(`[data-set="${i}"]`);

        if (!input1 || !input2) continue;

        const score1 = parseInt(input1.value) || 0;
        const score2 = parseInt(input2.value) || 0;

        if (score1 > 0 || score2 > 0) {
          if (score1 > score2) sets1++;
          else if (score2 > score1) sets2++;
        }
      }

      const display1 = team1.querySelector('[data-sets-won]');
      const display2 = team2.querySelector('[data-sets-won]');

      if (display1) display1.textContent = sets1 > 0 || sets2 > 0 ? sets1 : '-';
      if (display2) display2.textContent = sets1 > 0 || sets2 > 0 ? sets2 : '-';
    });
  }

  document.querySelectorAll('[data-set]').forEach(input => {
    input.addEventListener('input', calculateSetsWon);
  });
</script>

<style>
  h2 {
    color: #1a1a1a;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  h3 {
    color: #1a1a1a;
    font-size: 0.85rem;
    font-weight: 600;
    margin: 30px 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  h4 {
    color: #666;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .info {
    border: 1px solid #e5e5e5;
    padding: 16px 20px;
    border-radius: 8px;
    margin-bottom: 30px;
    text-align: center;
  }

  .info p {
    margin: 4px 0;
    font-size: 0.9rem;
    color: #444;
  }

  .modalidad {
    padding: 25px 0;
    border-bottom: 1px solid #eee;
  }

  .formato-nota {
    color: #888;
    font-size: 0.8rem;
    margin-bottom: 15px;
  }

  /* Participantes */
  .participantes-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
  }

  .participante-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    font-size: 0.9rem;
  }

  .letra {
    background: #f5f5f5;
    color: #666;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.8rem;
  }

  .letra-mini {
    background: #f0f0f0;
    color: #888;
    padding: 2px 6px;
    border-radius: 3px;
    font-weight: 600;
    font-size: 0.7rem;
    margin-right: 4px;
  }

  /* Partidos de grupos */
  .partidos-grupos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-bottom: 25px;
  }

  .ronda-partidos {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 15px;
  }

  .ronda-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    margin-bottom: 12px;
    text-align: center;
  }

  .partido-card {
    background: #fafafa;
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 8px;
  }

  .partido-card:last-child {
    margin-bottom: 0;
  }

  .partido-card.compact {
    padding: 8px 10px;
  }

  .partido-equipo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
  }

  .partido-equipo:first-child {
    border-bottom: 1px solid #eee;
  }

  .equipo-letra {
    font-weight: 600;
    font-size: 1rem;
    color: #333;
    width: 24px;
  }

  .puntos-set {
    display: flex;
    gap: 4px;
  }

  .puntos-set input {
    width: 40px;
    height: 32px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
    color: #333;
  }

  .puntos-set input:focus {
    outline: none;
    border-color: #999;
  }

  .puntos-set input.third {
    border-style: dashed;
    opacity: 0.6;
  }

  .sets-ganados {
    margin-right: auto;
    margin-left: 10px;
  }

  .sets-ganados span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #f9f9f9;
    font-size: 1rem;
    font-weight: 600;
    color: #333;
  }

  /* Clasificación */
  .clasificacion-box {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 15px;
    max-width: 450px;
  }

  .clasificacion-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .tabla-clasificacion {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .tabla-clasificacion th {
    text-align: left;
    padding: 6px 8px;
    border-bottom: 2px solid #eee;
    font-weight: 600;
    color: #888;
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .tabla-clasificacion td {
    padding: 8px;
    border-bottom: 1px solid #f5f5f5;
  }

  .tabla-clasificacion .pos {
    width: 25px;
    font-weight: 600;
    color: #888;
  }

  .tabla-clasificacion .nombre {
    font-weight: 500;
  }

  .tabla-clasificacion .pts {
    font-weight: 600;
  }

  .tabla-clasificacion th:not(:first-child):not(:nth-child(2)),
  .tabla-clasificacion td:not(:first-child):not(:nth-child(2)) {
    text-align: center;
    width: 35px;
  }

  /* Grupos individual */
  .grupos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .grupo-box {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 15px;
  }

  .participantes-mini {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 15px;
  }

  .participante-mini {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .participante-mini .letra {
    width: 20px;
    height: 20px;
    font-size: 0.75rem;
  }

  .partidos-lista {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Bracket de eliminatorias */
  .bracket {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 20px;
    overflow-x: auto;
    padding: 10px 0;
  }

  .bracket-round {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .round-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
    margin-bottom: 5px;
    text-align: center;
  }

  .match {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    overflow: hidden;
    min-width: 240px;
    background: #fff;
  }

  .match-team {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    border-bottom: 1px solid #f0f0f0;
  }

  .match-team:last-child {
    border-bottom: none;
  }

  .team-name {
    font-size: 0.8rem;
    font-weight: 500;
  }

  .score-boxes {
    display: flex;
    gap: 4px;
  }

  .score-input {
    width: 36px;
    height: 28px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    color: #333;
  }

  .score-input:focus {
    outline: none;
    border-color: #999;
  }

  .score-input.third {
    border-style: dashed;
    opacity: 0.6;
  }

  .score-total {
    margin-right: 8px;
  }

  .score-total span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #f9f9f9;
    font-size: 0.95rem;
    font-weight: 600;
    color: #333;
  }

  .final-match {
    border: 2px solid #ddd;
  }

  .final-match .match-team {
    background: #fafafa;
  }

  /* Conectores del bracket */
  .bracket-connector {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 140px;
    position: relative;
  }

  .connector-line {
    position: absolute;
    width: 20px;
    height: 1px;
    background: #ddd;
    left: 0;
  }

  .connector-line.top {
    top: 30px;
  }

  .connector-line.bottom {
    bottom: 30px;
  }

  .connector-merge {
    position: absolute;
    left: 20px;
    width: 1px;
    height: 80px;
    background: #ddd;
  }

  .connector-merge::after {
    content: '';
    position: absolute;
    right: -20px;
    top: 50%;
    width: 20px;
    height: 1px;
    background: #ddd;
  }

  .trophy {
    padding-left: 20px;
  }

  .trophy-icon {
