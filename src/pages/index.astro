<script>
  function calculateSetsWon() {
    document.querySelectorAll('[data-match]').forEach(match => {
      const team1 = match.querySelector('[data-team="1"]');
      const team2 = match.querySelector('[data-team="2"]');

      if (!team1 || !team2) return;

      let sets1 = 0;
      let sets2 = 0;

      for (let i = 1; i <= 3; i++) {
        const input1 = team1.querySelector(`[data-set="${i}"]`);
        const input2 = team2.querySelector(`[data-set="${i}"]`);

        if (!input1 || !input2) continue;

        const score1 = parseInt(input1.value) || 0;
        const score2 = parseInt(input2.value) || 0;

        if (score1 > 0 || score2 > 0) {
          if (score1 > score2) sets1++;
          else if (score2 > score1) sets2++;
        }
      }

      const display1 = team1.querySelector('[data-sets-won]');
      const display2 = team2.querySelector('[data-sets-won]');

      if (display1) display1.textContent = sets1 > 0 || sets2 > 0 ? sets1 : '-';
      if (display2) display2.textContent = sets1 > 0 || sets2 > 0 ? sets2 : '-';
    });
  }

  document.querySelectorAll('[data-set]').forEach(input => {
    input.addEventListener('input', calculateSetsWon);
  });
</script>

<style>
  h2 {
    color: #1a1a1a;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  h3 {
    color: #1a1a1a;
    font-size: 0.85rem;
    font-weight: 600;
    margin: 30px 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .info {
    border: 1px solid #e5e5e5;
    padding: 16px 20px;
    border-radius: 8px;
    margin-bottom: 30px;
    text-align: center;
  }

  .info p {
    margin: 4px 0;
    font-size: 0.9rem;
    color: #444;
  }

  .modalidad {
    padding: 25px 0;
    border-bottom: 1px solid #eee;
  }

  /* Participantes */
  .participantes-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
  }

  .participante-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    font-size: 0.9rem;
  }

  .letra {
    background: #f5f5f5;
    color: #666;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.8rem;
  }

  /* Bracket */
  .bracket-container {
    margin-top: 15px;
  }

  .bracket {
    display: flex;
    align-items: center;
    gap: 0;
    overflow-x: auto;
    padding: 10px 0;
  }

  .bracket-round {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .round-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
    margin-bottom: 8px;
    text-align: center;
  }

  .match {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    overflow: hidden;
    min-width: 220px;
    background: #fff;
  }

  .match-team {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    border-bottom: 1px solid #f0f0f0;
  }

  .match-team:last-child {
    border-bottom: none;
  }

  .team-name {
    font-size: 0.85rem;
    font-weight: 500;
    min-width: 70px;
  }

  .score-total {
    margin-right: 8px;
  }

  .score-total span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #f9f9f9;
    font-size: 0.95rem;
    font-weight: 600;
    color: #333;
  }

  .score-boxes {
    display: flex;
    gap: 4px;
  }

  .score-input {
    width: 36px;
    height: 28px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    color: #333;
  }

  .score-input:focus {
    outline: none;
    border-color: #999;
  }

  .score-input.third {
    border-style: dashed;
    opacity: 0.6;
  }

  .final-match {
    border: 2px solid #ddd;
  }

  .final-match .match-team {
    background: #fafafa;
  }

  /* Conectores */
  .bracket-connector {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 140px;
    position: relative;
  }

  .bracket-connector.single {
    height: 60px;
  }

  .connector-line {
    position: absolute;
    width: 20px;
    height: 1px;
    background: #ddd;
    left: 0;
  }

  .connector-line.top {
    top: 30px;
  }

  .connector-line.bottom {
    bottom: 30px;
  }

  .connector-line.middle {
    top: 50%;
  }

  .connector-merge {
    position: absolute;
    left: 20px;
    width: 1px;
    height: 80px;
    background: #ddd;
  }

  .connector-merge::after {
    content: '';
    position: absolute;
    right: -20px;
    top: 50%;
    width: 20px;
    height: 1px;
    background: #ddd;
  }

  .trophy {
    padding-left: 20px;
  }

  .trophy-icon {
    font-size: 2rem;
  }

  .trophy-icon.small {
    font-size: 1.5rem;
    margin-top: 10px;
  }

  /* Tercer puesto y puestos inferiores */
  .tercer-puesto,
  .quinto-puesto {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px dashed #ddd;
  }

  .puestos-inferiores {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
  }

  .bye-box {
    padding: 12px 15px;
    background: #f9f9f9;
    border: 1px dashed #ddd;
    border-radius: 6px;
    font-size: 0.8rem;
    color: #666;
    text-align: center;
    margin-top: 10px;
  }

  .bye-match {
    background: #f9f9f9;
  }

  .bye-match .match-team {
    justify-content: center;
    padding: 12px;
  }

  .sin-participacion {
    padding: 20px 0;
    color: #999;
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .bracket {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }

    .bracket-connector {
      display: none;
    }

    .bracket-round {
      width: 100%;
    }

    .match {
      width: 100%;
      max-width: 300px;
    }

    .trophy {
      padding-left: 0;
      align-self: center;
    }

    .puestos-inferiores {
      flex-direction: column;
    }
  }
</style>
