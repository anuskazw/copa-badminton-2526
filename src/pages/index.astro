---
import Layout from '../layouts/Layout.astro';

// Participantes DOBLES FEMENINO
const parejasFemenino = [
  'Margarita Arizaga y Dora Yánez',
  'Paula Bak y Mónica Castrillejo',
  'Nadia Marcos y María Jesús Serna',
  'Mónica Rodríguez y Ana María Caballero'
];

// Participantes INDIVIDUAL FEMENINO
const individualFemenino = [
  'Mónica Rodríguez',
  'Paula Bak',
  'Margarita Arizaga',
  'Mónica Castrillejo',
  'Jamie Gissel Valencia'
];

// Categorías sin participación
const sinParticipacion = ['Dobles Mixto', 'Dobles Masculino', 'Individual Masculino'];
---

<Layout title="Copa de Bádminton FMDS 2025/2026">
  <div class="info">
    <p><strong>📍 Pistas disponibles:</strong> 10:00 - 20:00</p>
    <p><strong>⚡ Formato:</strong> Mejor de 3 sets</p>
  </div>

  <section class="categoria activa">
    <h3>👥 DOBLES FEMENINO</h3>
    <div class="participantes">
      {parejasFemenino.map(pareja => (
        <div class="participante">{pareja}</div>
      ))}
    </div>
  </section>

  <section class="categoria activa">
    <h3>🏃‍♀️ INDIVIDUAL FEMENINO</h3>
    <div class="participantes">
      {individualFemenino.map(nombre => (
        <div class="participante">{nombre}</div>
      ))}
    </div>
  </section>

  <section class="categoria inactiva">
    <h3>Sin participación</h3>
    <div class="categorias-inactivas">
      {sinParticipacion.map(cat => (
        <span class="badge">{cat}</span>
      ))}
    </div>
  </section>
</Layout>

<style>
  h3 {
    color: #1a1a1a;
    margin-bottom: 15px;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info {
    border: 1px solid #e5e5e5;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 30px;
    text-align: center;
  }

  .info p {
    margin: 6px 0;
    font-size: 0.95rem;
    color: #444;
  }

  .categoria {
    padding: 25px 0;
    margin-bottom: 10px;
    border-bottom: 1px solid #eee;
  }

  .categoria:last-child {
    border-bottom: none;
  }

  .categoria.inactiva {
    opacity: 0.5;
  }

  .participantes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    margin-top: 15px;
  }

  .participante {
    padding: 12px 16px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    color: #333;
    font-size: 0.95rem;
  }

  .categorias-inactivas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .badge {
    color: #888;
    padding: 4px 0;
    font-size: 0.9rem;
  }

  .badge:not(:last-child)::after {
    content: "·";
    margin-left: 8px;
    color: #ccc;
  }

  @media (max-width: 768px) {
    .participantes {
      grid-template-columns: 1fr;
    }
  }
</style>
