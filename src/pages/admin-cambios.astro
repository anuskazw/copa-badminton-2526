---
import Layout from '../layouts/Layout.astro';

// DOBLES FEMENINO
const doblesParticipantes = [
  { letra: 'A', nombre: '' },
  { letra: 'B', nombre: '' },
  { letra: 'C', nombre: '' },
  { letra: 'D', nombre: '' }
];

// INDIVIDUAL FEMENINO
const individualParticipantes = [
  { letra: 'A', nombre: '' },
  { letra: 'B', nombre: '' },
  { letra: 'C', nombre: '' },
  { letra: 'D', nombre: '' },
  { letra: 'E', nombre: '' }
