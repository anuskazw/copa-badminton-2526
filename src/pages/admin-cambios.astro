---

<Layout title="Copa de Bádminton FMDS 2025/2026">
  <div class="info">
    <p><strong>📍 Horario:</strong> 10:00 - 20:00</p>
    <p><strong>📋 Formato:</strong> 2 sets a 21 · Tercer set a 15 si hay empate</p>
  </div>

  <!-- DOBLES FEMENINO -->
  <section class="modalidad modalidad-dobles" id="dobles-femenino">
    <h2>
      <span>Dobles Femenino</span>
      <button class="btn-print-section" data-section="dobles-femenino" title="Imprimir cuadro">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6,9 6,2 18,2 18,9"></polyline>
          <path d="M6,18 L4,18 C2.9,18 2,17.1 2,16 L2,11 C2,9.9 2.9,9 4,9 L20,9 C21.1,9 22,9.9 22,11 L22,16 C22,17.1 21.1,18 20,18 L18,18"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
      </button>
    </h2>

    <h3>Participantes</h3>
    <div class="participantes-grid">
      {doblesParticipantes.map(p => (
        <div class="participante-tag">
          <span class="letra">{p.letra}</span>
          <input type="text" class="participante-input" data-participante={`dobles-${p.letra}`} value={p.nombre} />
        </div>
      ))}
    </div>

    <h3>Cuadro de Eliminatorias</h3>
    <div class="bracket-container">
      <div class="bracket">
        <div class="bracket-round">
          <div class="round-label">Semifinales</div>
          <div class="match" data-match>
            <div class="match-team" data-team="1">
              <span class="team-name" data-show="dobles-A">{doblesParticipantes[0].nombre}</span>
              <div class="score-total"><span data-sets-won>-</span></div>
              <div class="score-boxes">
                <input type="text" class="score-input" maxlength="2" data-set="1" />
                <input type="text" class="score-input" maxlength="2" data-set="2" />
                <input type="text" class="score-input third" maxlength="2" data-set="3" />
              </div>
            </div>
            <div class="match-team" data-team="2">
              <span class="team-name" data-show="dobles-D">{doblesParticipantes[3].nombre}</span>
              <div class="score-total"><span data-sets-won>-</span></div>
              <div class="score-boxes">
                <input type="text" class="score-input" maxlength="2" data-set="1" />
                <input type="text" class="score-input" maxlength="2" data-set="2" />
                <input type="text" class="score-input third" maxlength="2" data-set="3" />
              </div>
            </div>
          </div>
          <div class="match" data-match>
            <div class="match-team" data-team="1">
              <span class="team-name" data-show="dobles-B">{doblesParticipantes[1].nombre}</span>
              <div class="score-total"><span data-sets-won>-</span></div>
              <div class="score-boxes">
                <input type="text" class="score-input" maxlength="2" data-set="1" />
                <input type="text" class="score-input" maxlength="2" data-set="2" />
                <input type="text" class="score-input third" maxlength="2" data-set="3" />
              </div>
            </div>
            <div class="match-team" data-team="2">
              <span class="team-name" data-show="dobles-C">{doblesParticipantes[2].nombre}</span>
