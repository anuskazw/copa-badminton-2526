<script>
  function calculateSetsWon() {
    document.querySelectorAll('[data-match]').forEach(match => {
      const team1 = match.querySelector('[data-team="1"]');
      const team2 = match.querySelector('[data-team="2"]');

      if (!team1 || !team2) return;

      let sets1 = 0;
      let sets2 = 0;

      for (let i = 1; i <= 3; i++) {
        const input1 = team1.querySelector(`[data-set="${i}"]`);
        const input2 = team2.querySelector(`[data-set="${i}"]`);

        if (!input1 || !input2) continue;

        const score1 = parseInt(input1.value) || 0;
        const score2 = parseInt(input2.value) || 0;

        if (score1 > 0 || score2 > 0) {
          if (score1 > score2) sets1++;
          else if (score2 > score1) sets2++;
        }
      }

      const display1 = team1.querySelector('[data-sets-won]');
      const display2 = team2.querySelector('[data-sets-won]');

      if (display1) display1.textContent = sets1 > 0 || sets2 > 0 ? sets1 : '-';
      if (display2) display2.textContent = sets1 > 0 || sets2 > 0 ? sets2 : '-';
    });
  }

  document.querySelectorAll('[data-set]').forEach(input => {
    input.addEventListener('input', calculateSetsWon);
  });

  // Sincronizar nombres de participantes
  document.querySelectorAll('[data-participante]').forEach(input => {
    input.addEventListener('input', (e) => {
      const key = e.target.dataset.participante;
      document.querySelectorAll(`[data-show="${key}"]`).forEach(span => {
        span.textContent = e.target.value;
      });
    });
  });

  // Imprimir sección individual en formato horizontal
  document.querySelectorAll('.btn-print-section').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const sectionId = e.currentTarget.dataset.section;
      document.body.setAttribute('data-print-section', sectionId);
      window.print();
      document.body.removeAttribute('data-print-section');
    });
  });

  // Calcular clasificación
  function getMatchResult(match) {
    const team1 = match.querySelector('[data-team="1"]');
    const team2 = match.querySelector('[data-team="2"]');
    if (!team1 || !team2) return null;

    let sets1 = 0, sets2 = 0;
    let points1 = 0, points2 = 0;

    for (let i = 1; i <= 3; i++) {
      const input1 = team1.querySelector(`[data-set="${i}"]`);
      const input2 = team2.querySelector(`[data-set="${i}"]`);
      if (!input1 || !input2) continue;

      const score1 = parseInt(input1.value) || 0;
      const score2 = parseInt(input2.value) || 0;

      points1 += score1;
      points2 += score2;

      if (score1 > 0 || score2 > 0) {
        if (score1 > score2) sets1++;
        else if (score2 > score1) sets2++;
      }
    }

    const name1 = team1.querySelector('.team-name')?.textContent || '';
    const name2 = team2.querySelector('.team-name')?.textContent || '';

    return {
      team1: { name: name1, sets: sets1, points: points1 },
      team2: { name: name2, sets: sets2, points: points2 },
      winner: sets1 > sets2 ? 1 : sets2 > sets1 ? 2 : 0,
      played: sets1 > 0 || sets2 > 0
    };
  }

  function updateClasificacion() {
    // DOBLES FEMENINO
    const doblesSection = document.getElementById('dobles-femenino');
    const doblesMatches = doblesSection.querySelectorAll('[data-match]');
    const doblesTable = doblesSection.querySelector('[data-clasificacion="dobles"] tbody');

    const doblesStats = {};
    const initStats = (name) => {
      if (name && !doblesStats[name] && !name.includes('Gan.') && !name.includes('Perd.')) {
        doblesStats[name] = { pj: 0, pg: 0, pp: 0, setsF: 0, setsC: 0 };
      }
    };

    doblesMatches.forEach(match => {
      const result = getMatchResult(match);
      if (!result || !result.played) return;

      const { team1, team2, winner } = result;
      initStats(team1.name);
      initStats(team2.name);

      if (doblesStats[team1.name]) {
        doblesStats[team1.name].pj++;
        doblesStats[team1.name].setsF += team1.sets;
        doblesStats[team1.name].setsC += team2.sets;
        if (winner === 1) doblesStats[team1.name].pg++;
        else if (winner === 2) doblesStats[team1.name].pp++;
      }

      if (doblesStats[team2.name]) {
        doblesStats[team2.name].pj++;
        doblesStats[team2.name].setsF += team2.sets;
        doblesStats[team2.name].setsC += team1.sets;
        if (winner === 2) doblesStats[team2.name].pg++;
        else if (winner === 1) doblesStats[team2.name].pp++;
      }
    });

    const doblesRanking = Object.entries(doblesStats)
      .map(([name, stats]) => ({ name, ...stats, diff: stats.setsF - stats.setsC }))
      .sort((a, b) => b.pg - a.pg || b.diff - a.diff || b.setsF - a.setsF);

    const doblesRows = doblesTable.querySelectorAll('tr');
    doblesRows.forEach((row, i) => {
      const cells = row.querySelectorAll('td');
      if (doblesRanking[i]) {
        const p = doblesRanking[i];
        cells[1].textContent = p.name;
        cells[2].textContent = p.pj;
        cells[3].textContent = p.pg;
        cells[4].textContent = p.pp;
        cells[5].textContent = p.setsF;
        cells[6].textContent = p.setsC;
        cells[7].textContent = p.diff > 0 ? `+${p.diff}` : p.diff;
      } else {
        for (let j = 1; j < cells.length; j++) cells[j].textContent = '-';
      }
    });

    // INDIVIDUAL FEMENINO
    const individualSection = document.getElementById('individual-femenino');
    const individualMatches = individualSection.querySelectorAll('[data-match]');
    const individualTable = individualSection.querySelector('[data-clasificacion="individual"] tbody');

    const individualStats = {};
    const initIndStats = (name) => {
      if (name && !individualStats[name] && !name.includes('Gan.') && !name.includes('Perd.')) {
        individualStats[name] = { pj: 0, pg: 0, pp: 0, setsF: 0, setsC: 0 };
      }
    };

    individualMatches.forEach(match => {
      const result = getMatchResult(match);
      if (!result || !result.played) return;

      const { team1, team2, winner } = result;
      initIndStats(team1.name);
      initIndStats(team2.name);

      if (individualStats[team1.name]) {
        individualStats[team1.name].pj++;
        individualStats[team1.name].setsF += team1.sets;
        individualStats[team1.name].setsC += team2.sets;
        if (winner === 1) individualStats[team1.name].pg++;
        else if (winner === 2) individualStats[team1.name].pp++;
      }

      if (individualStats[team2.name]) {
        individualStats[team2.name].pj++;
        individualStats[team2.name].setsF += team2.sets;
        individualStats[team2.name].setsC += team1.sets;
        if (winner === 2) individualStats[team2.name].pg++;
        else if (winner === 1) individualStats[team2.name].pp++;
      }
    });

    const individualRanking = Object.entries(individualStats)
      .map(([name, stats]) => ({ name, ...stats, diff: stats.setsF - stats.setsC }))
      .sort((a, b) => b.pg - a.pg || b.diff - a.diff || b.setsF - a.setsF);

    const individualRows = individualTable.querySelectorAll('tr');
    individualRows.forEach((row, i) => {
      const cells = row.querySelectorAll('td');
      if (individualRanking[i]) {
        const p = individualRanking[i];
        cells[1].textContent = p.name;
        cells[2].textContent = p.pj;
        cells[3].textContent = p.pg;
        cells[4].textContent = p.pp;
        cells[5].textContent = p.setsF;
        cells[6].textContent = p.setsC;
        cells[7].textContent = p.diff > 0 ? `+${p.diff}` : p.diff;
      } else {
        for (let j = 1; j < cells.length; j++) cells[j].textContent = '-';
      }
    });
  }

  document.querySelectorAll('[data-set]').forEach(input => {
    input.addEventListener('input', updateClasificacion);
  });

  // === SINCRONIZACIÓN CON API ===
  const API_URL = '/api/resultados';
  let isSaving = false;

  // Recopilar todos los datos del formulario
  function collectData() {
    const data = {
      dobles: {
        participantes: {},
        partidos: []
      },
      individual: {
        participantes: {},
        partidos: []
      },
      programacion: []
    };

    // Participantes dobles
    document.querySelectorAll('#dobles-femenino [data-participante]').forEach(input => {
      const key = input.dataset.participante.replace('dobles-', '');
      data.dobles.participantes[key] = input.value;
    });

    // Participantes individual
    document.querySelectorAll('#individual-femenino [data-participante]').forEach(input => {
      const key = input.dataset.participante.replace('individual-', '');
      data.individual.participantes[key] = input.value;
    });

    // Partidos dobles
    document.querySelectorAll('#dobles-femenino [data-match]').forEach(match => {
      const partido = { equipo1: [], equipo2: [] };
      match.querySelectorAll('[data-team="1"] [data-set]').forEach(input => {
        partido.equipo1.push(input.value);
      });
      match.querySelectorAll('[data-team="2"] [data-set]').forEach(input => {
        partido.equipo2.push(input.value);
      });
      data.dobles.partidos.push(partido);
    });

    // Partidos individual
    document.querySelectorAll('#individual-femenino [data-match]').forEach(match => {
      const partido = { equipo1: [], equipo2: [] };
      match.querySelectorAll('[data-team="1"] [data-set]').forEach(input => {
        partido.equipo1.push(input.value);
      });
      match.querySelectorAll('[data-team="2"] [data-set]').forEach(input => {
        partido.equipo2.push(input.value);
      });
      data.individual.partidos.push(partido);
    });

    // Programación
    document.querySelectorAll('#programacion-tbody tr').forEach(row => {
      const enfrentamiento = row.querySelector('.input-enfrentamiento')?.value || '';
      const modalidad = row.querySelector('.input-modalidad')?.value || '';
      const pista = row.querySelector('.input-pista')?.value || '';
      const hora = row.querySelector('.input-hora')?.value || '';
      data.programacion.push({ enfrentamiento, modalidad, pista, hora });
    });

    return data;
  }

  // Aplicar datos al formulario
  function applyData(data) {
    if (!data) return;

    // Participantes dobles
    if (data.dobles?.participantes) {
      Object.entries(data.dobles.participantes).forEach(([key, value]) => {
        const input = document.querySelector(`[data-participante="dobles-${key}"]`);
        if (input && input.value !== value) {
          input.value = value;
          document.querySelectorAll(`[data-show="dobles-${key}"]`).forEach(span => {
            span.textContent = value;
          });
        }
      });
    }

    // Participantes individual
    if (data.individual?.participantes) {
      Object.entries(data.individual.participantes).forEach(([key, value]) => {
        const input = document.querySelector(`[data-participante="individual-${key}"]`);
        if (input && input.value !== value) {
          input.value = value;
          document.querySelectorAll(`[data-show="individual-${key}"]`).forEach(span => {
            span.textContent = value;
          });
        }
      });
    }

    // Partidos dobles
    if (data.dobles?.partidos) {
      const doblesMatches = document.querySelectorAll('#dobles-femenino [data-match]');
      data.dobles.partidos.forEach((partido, i) => {
        if (!doblesMatches[i]) return;
        const inputs1 = doblesMatches[i].querySelectorAll('[data-team="1"] [data-set]');
        const inputs2 = doblesMatches[i].querySelectorAll('[data-team="2"] [data-set]');
        partido.equipo1.forEach((val, j) => { if (inputs1[j]) inputs1[j].value = val; });
        partido.equipo2.forEach((val, j) => { if (inputs2[j]) inputs2[j].value = val; });
      });
    }

    // Partidos individual
    if (data.individual?.partidos) {
      const individualMatches = document.querySelectorAll('#individual-femenino [data-match]');
      data.individual.partidos.forEach((partido, i) => {
        if (!individualMatches[i]) return;
        const inputs1 = individualMatches[i].querySelectorAll('[data-team="1"] [data-set]');
        const inputs2 = individualMatches[i].querySelectorAll('[data-team="2"] [data-set]');
        partido.equipo1.forEach((val, j) => { if (inputs1[j]) inputs1[j].value = val; });
        partido.equipo2.forEach((val, j) => { if (inputs2[j]) inputs2[j].value = val; });
      });
    }

    calculateSetsWon();
    updateClasificacion();

    // Programación
    if (data.programacion) {
      applyProgramacion(data.programacion);
    }
  }

  // === GESTIÓN DE PROGRAMACIÓN ===
  const programacionTbody = document.getElementById('programacion-tbody');
  const btnAddPartido = document.getElementById('btn-add-partido');
  let draggedRow = null;

  function createProgramacionRow(partido = {}) {
    const tr = document.createElement('tr');
    tr.draggable = true;
    tr.innerHTML = `
      <td class="drag-handle" title="Arrastrar para reordenar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="8" x2="20" y2="8"></line>
          <line x1="4" y1="16" x2="20" y2="16"></line>
        </svg>
      </td>
      <td><input type="text" class="prog-input input-enfrentamiento" placeholder="Ej: A vs B" value="${partido.enfrentamiento || ''}" /></td>
      <td><input type="text" class="prog-input input-modalidad" placeholder="Ej: Dobles F" value="${partido.modalidad || ''}" /></td>
      <td><input type="text" class="prog-input input-pista" placeholder="1" value="${partido.pista || ''}" /></td>
      <td><input type="text" class="prog-input input-hora" placeholder="10:00" value="${partido.hora || ''}" /></td>
      <td>
        <button class="btn-delete-row" title="Eliminar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </td>
    `;

    // Event listeners para drag & drop
    tr.addEventListener('dragstart', handleDragStart);
    tr.addEventListener('dragend', handleDragEnd);
    tr.addEventListener('dragover', handleDragOver);
    tr.addEventListener('dragleave', handleDragLeave);
    tr.addEventListener('drop', handleDrop);

    // Event listener para eliminar
    tr.querySelector('.btn-delete-row').addEventListener('click', () => {
      tr.remove();
      hasChanges = true;
      saveData();
    });

    // Event listeners para inputs
    tr.querySelectorAll('.prog-input').forEach(input => {
      input.addEventListener('focus', () => { isInputFocused = true; });
      input.addEventListener('blur', () => {
        isInputFocused = false;
        if (hasChanges) {
          saveData();
          hasChanges = false;
        }
      });
      input.addEventListener('input', () => { hasChanges = true; });
    });

    return tr;
  }

  function handleDragStart(e) {
    draggedRow = this;
    this.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  }

  function handleDragEnd(e) {
    this.classList.remove('dragging');
    document.querySelectorAll('#programacion-tbody tr').forEach(row => {
      row.classList.remove('drag-over');
    });
    draggedRow = null;
  }

  function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if (this !== draggedRow) {
      this.classList.add('drag-over');
    }
  }

  function handleDragLeave(e) {
    this.classList.remove('drag-over');
  }

  function handleDrop(e) {
    e.preventDefault();
    this.classList.remove('drag-over');
    if (draggedRow && this !== draggedRow) {
      const allRows = [...programacionTbody.querySelectorAll('tr')];
      const draggedIdx = allRows.indexOf(draggedRow);
      const targetIdx = allRows.indexOf(this);

      if (draggedIdx < targetIdx) {
        this.parentNode.insertBefore(draggedRow, this.nextSibling);
      } else {
        this.parentNode.insertBefore(draggedRow, this);
      }

      hasChanges = true;
      saveData();
    }
  }

  function applyProgramacion(programacion) {
    // Solo actualizar si hay cambios reales
    const currentRows = programacionTbody.querySelectorAll('tr');

    // Verificar si necesitamos actualizar
    if (currentRows.length === programacion.length) {
      let needsUpdate = false;
      currentRows.forEach((row, i) => {
        const p = programacion[i];
        if (row.querySelector('.input-enfrentamiento')?.value !== p.enfrentamiento ||
            row.querySelector('.input-modalidad')?.value !== p.modalidad ||
            row.querySelector('.input-pista')?.value !== p.pista ||
            row.querySelector('.input-hora')?.value !== p.hora) {
          needsUpdate = true;
        }
      });
      if (!needsUpdate) return;
    }

    // Limpiar y recrear filas
    programacionTbody.innerHTML = '';
    programacion.forEach(partido => {
      programacionTbody.appendChild(createProgramacionRow(partido));
    });
  }

  // Añadir nuevo partido
  btnAddPartido.addEventListener('click', () => {
    programacionTbody.appendChild(createProgramacionRow());
    hasChanges = true;
    saveData();
  });

  // Cargar datos de la API
  async function loadData() {
    try {
      const res = await fetch(API_URL + '?t=' + Date.now(), {
        cache: 'no-store'
      });
      if (res.ok) {
        const data = await res.json();
        applyData(data);
      }
    } catch (e) {
      console.log('Error cargando datos:', e);
    }
  }

  // Guardar datos en la API
  async function saveData() {
    if (isSaving) return;
    isSaving = true;
    try {
      const data = collectData();
      await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
    } catch (e) {
      console.log('Error guardando datos:', e);
    }
    isSaving = false;
  }

  // Control de foco para evitar actualizaciones mientras se edita
  let isInputFocused = false;
  let hasChanges = false;

  // Escuchar cambios en todos los inputs
  document.querySelectorAll('input').forEach(input => {
    input.addEventListener('focus', () => {
      isInputFocused = true;
    });

    input.addEventListener('blur', () => {
      isInputFocused = false;
      if (hasChanges) {
        saveData();
        hasChanges = false;
      }
    });

    input.addEventListener('input', () => {
      hasChanges = true;
      calculateSetsWon();
      updateClasificacion();
    });
  });

  // Cargar datos al iniciar
  loadData();

  // Actualizar cada 2 segundos solo si no hay input enfocado
  setInterval(() => {
    if (!isInputFocused) {
      loadData();
    }
  }, 2000);
</script>

